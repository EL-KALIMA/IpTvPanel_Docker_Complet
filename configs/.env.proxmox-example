# ============================================================================
# IPTV Panel - Configuration pour Proxmox
# ============================================================================
# Ce fichier est un template de configuration optimisé pour Proxmox VE
# Copiez ce fichier vers .env et remplissez les valeurs appropriées
#
# IMPORTANT: Ne commitez JAMAIS ce fichier avec vos vraies valeurs!
# ============================================================================

# ============================================================================
# CONFIGURATION DOMAINE & SSL
# ============================================================================

# Nom de domaine pour accéder au panel
# Ex: panel.mondomaine.com ou iptv.example.com
# Pour accès local uniquement, vous pouvez utiliser l'IP: panel.local
PANEL_DOMAIN=panel.example.com

# Email pour les notifications Let's Encrypt et les alertes système
# Utilisé pour le renouvellement automatique des certificats SSL
CERTBOT_EMAIL=admin@example.com

# ============================================================================
# CONFIGURATION BASE DE DONNÉES POSTGRESQL
# ============================================================================

# Nom de la base de données (recommandé: laisser par défaut)
DB_NAME=iptv_panel

# Nom d'utilisateur de la base de données (recommandé: laisser par défaut)
DB_USER=iptv_admin

# Mot de passe de la base de données
# IMPORTANT: Changez cette valeur par un mot de passe fort!
# Générez un mot de passe sécurisé avec: openssl rand -hex 24
DB_PASS=CHANGEME_DB_PASSWORD_HERE

# ============================================================================
# CONFIGURATION APPLICATION
# ============================================================================

# Clé secrète Flask pour les sessions
# IMPORTANT: Changez cette valeur!
# Générez avec: openssl rand -hex 32
SECRET_KEY=CHANGEME_FLASK_SECRET_KEY_HERE

# Mot de passe du compte administrateur par défaut
# Username: admin
# IMPORTANT: Changez ce mot de passe après la première connexion!
ADMIN_PASSWORD=CHANGEME_ADMIN_PASSWORD_HERE

# Token API pour l'authentification des scripts
# Utilisé par user_manager.sh et autres outils
# Générez avec: openssl rand -hex 32
ADMIN_API_TOKEN=CHANGEME_API_TOKEN_HERE

# ============================================================================
# CONFIGURATION SERVEUR DE STREAMING (OPTIONNEL)
# ============================================================================
# Ces paramètres sont optionnels et peuvent être configurés plus tard
# via l'interface web du panel.

# Domaine du serveur de streaming
# Ex: stream.mondomaine.com
STREAM_DOMAIN=

# Adresse IP du serveur de streaming
# Ex: 95.217.193.163
STREAM_SERVER_IP=

# URL de base de l'API du serveur de streaming
# Ex: http://95.217.193.163:5000
STREAMING_API_BASE_URL=

# Token d'authentification pour l'API de streaming
# Doit correspondre au token configuré sur le serveur de streaming
STREAMING_API_TOKEN=

# Timeout en secondes pour les requêtes API vers le serveur de streaming
STREAMING_API_TIMEOUT=10

# Nom d'utilisateur pour l'administration du serveur de streaming
STREAMING_SERVER_USER=

# Mot de passe pour l'administration du serveur de streaming
STREAMING_SERVER_PASS=

# ============================================================================
# CONFIGURATION CLOUDFLARE (OPTIONNEL)
# ============================================================================
# Pour utiliser Cloudflare CDN et le cache purging automatique

# Token API Cloudflare
# Créé dans: Cloudflare Dashboard → My Profile → API Tokens
# Permissions requises: Zone.Cache Purge, Zone.Zone Settings Read
CLOUDFLARE_API_TOKEN=

# Zone ID de votre domaine dans Cloudflare
# Trouvé dans: Cloudflare Dashboard → Votre domaine → Overview (colonne de droite)
CLOUDFLARE_ZONE_ID=

# ============================================================================
# CONFIGURATION RÉSEAU PROXMOX
# ============================================================================
# Ces variables sont automatiquement configurées par le script d'installation
# mais peuvent être ajustées selon votre configuration réseau Proxmox

# Bridge réseau utilisé (généralement vmbr0)
# PROXMOX_BRIDGE=vmbr0

# Sous-réseau local (détecté automatiquement)
# LOCAL_SUBNET=192.168.1.0/24

# Gateway par défaut (détecté automatiquement)
# GATEWAY=192.168.1.1

# ============================================================================
# OPTIMISATIONS POUR PROXMOX
# ============================================================================

# Désactiver le swap pour meilleures performances (recommandé pour LXC)
# DISABLE_SWAP=true

# Activer les optimisations réseau
# NETWORK_OPTIMIZATIONS=true

# ============================================================================
# CONFIGURATION MONITORING & ALERTES
# ============================================================================

# Email pour les alertes de monitoring
# ALERT_EMAIL=admin@example.com

# Seuil d'alerte CPU (pourcentage)
# CPU_THRESHOLD=80

# Seuil d'alerte mémoire (pourcentage)
# MEMORY_THRESHOLD=80

# Seuil d'alerte disque (pourcentage)
# DISK_THRESHOLD=85

# ============================================================================
# CONFIGURATION SAUVEGARDES
# ============================================================================

# Répertoire de destination des sauvegardes
# BACKUP_DIR=/opt/backups/iptv

# Nombre de jours de rétention des sauvegardes
# BACKUP_RETENTION_DAYS=7

# Activer les notifications email pour les sauvegardes
# BACKUP_EMAIL_NOTIFICATIONS=false

# ============================================================================
# CONFIGURATION AVANCÉE
# ============================================================================

# Mode debug (true/false)
# ATTENTION: Ne pas activer en production!
# DEBUG=false

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Timezone
# TZ=Europe/Paris

# ============================================================================
# NOTES IMPORTANTES
# ============================================================================
#
# 1. SÉCURITÉ:
#    - Changez TOUS les mots de passe et tokens par défaut
#    - Utilisez des mots de passe forts (minimum 16 caractères)
#    - Ne partagez jamais ce fichier .env
#    - Définissez les permissions: chmod 600 .env
#
# 2. PERFORMANCE PROXMOX:
#    - Pour LXC: Utilisez au minimum 2 CPU cores et 2GB RAM
#    - Pour VM: Utilisez au minimum 2 CPU cores et 2GB RAM
#    - Activez VirtIO pour les VMs pour meilleures performances réseau
#    - Considérez l'utilisation de SSD pour le stockage
#
# 3. RÉSEAU:
#    - Assurez-vous que les ports 80 et 443 sont ouverts
#    - Pour accès externe, configurez le port forwarding sur votre routeur
#    - Utilisez un VPN (WireGuard/Tailscale) pour accès sécurisé
#
# 4. CERTIFICATS SSL:
#    - Le script génère un certificat auto-signé par défaut
#    - Pour un certificat Let's Encrypt valide, votre domaine doit pointer
#      vers votre IP publique et être accessible depuis Internet
#    - Configurez le renouvellement automatique avec cron
#
# 5. SAUVEGARDES:
#    - Configurez des sauvegardes automatiques avec cron
#    - Testez régulièrement la restauration
#    - Conservez les sauvegardes sur un stockage séparé
#    - Utilisez les snapshots Proxmox en complément
#
# 6. MONITORING:
#    - Activez le monitoring automatique avec cron
#    - Configurez les alertes email
#    - Surveillez les logs régulièrement
#
# ============================================================================
# GÉNÉRATION DE VALEURS SÉCURISÉES
# ============================================================================
#
# Utilisez ces commandes pour générer des valeurs sécurisées:
#
# Mot de passe fort (24 caractères):
#   openssl rand -hex 24
#
# Clé secrète Flask (64 caractères):
#   openssl rand -hex 32
#
# Token API (64 caractères):
#   openssl rand -hex 32
#
# ============================================================================
